@using System.Globalization
@using FrostWyrm.Math.Hex
@inject ContentCatalog Catalog

@if (Markers.Count > 0)
{
    <label class="piece-toggle"><input type="checkbox" @bind="_showPieces" /> Show recorded cubes and discs</label>
}
<div class="board-scroll">
<svg class="board" viewBox="@ViewBox" role="group" aria-label="Reference hex board. Rows A to I, columns 1 to 12.">
    @foreach (var space in Board.Spaces)
    {
        var p = Pixel(space);
        <g class="hex-cell @(Selected == space.Position ? "selected" : "")" role="button" tabindex="0"
           aria-label="@Label(space)" aria-pressed="@(Selected == space.Position ? "true" : "false")"
           @onclick="() => SelectedChanged.InvokeAsync(space.Position)" @onkeydown="e => Key(e, space.Position)"
           @onmouseenter="() => _hovered = space.Position" @onmouseleave="() => _hovered = null"
           @onfocus="() => _focused = space.Position" @onblur="() => _focused = null">
            <title>@Label(space)</title>
            <polygon points="@Points(p.X, p.Y)" class="terrain @space.Terrain.ToString().ToLowerInvariant()" />
            <text x="@F(p.X)" y="@F(p.Y + 10)" class="coordinate">@space.Position</text>
            @if (space.Animal != Animal.None)
            { <g><text x="@F(p.X - 9)" y="@F(p.Y - 7)" class="feature">@(space.Animal == Animal.Bear ? "B" : "C")</text></g> }
            @if (space.Structure is { } structure)
            { <g><text x="@F(p.X + 9)" y="@F(p.Y - 7)" class="structure @structure.Color.ToString().ToLowerInvariant()">@(structure.Kind == StructureKind.Stone ? "⬟" : "▲")</text></g> }
            @if (_showPieces)
            {
                var pieces = Markers.Where(m => m.Position == space.Position).ToArray();
                @for (var i = 0; i < pieces.Length; i++)
                {
                    var marker = pieces[i];
                    var x = p.X + (i - (pieces.Length - 1) / 2.0) * 7.5;
                    <g class="board-piece book-@ColorFor(marker.Book)" role="img" aria-label="@($"{marker.Book} {ColorFor(marker.Book)} {marker.Piece} at {marker.Position}")">
                        <title>@marker.Book · @ColorFor(marker.Book) · @marker.Piece · @marker.Position</title>
                        @if (marker.Piece == Piece.Cube)
                        { <rect class="piece-shape" x="@F(x - 3.1)" y="@F(p.Y - 3.1)" width="6.2" height="6.2" /> }
                        else
                        { <circle class="piece-shape" cx="@F(x)" cy="@F(p.Y)" r="3.2" /> }
                    </g>
                }
            }
        </g>
    }
    @* Paint interaction outlines after all cells so neighbors cannot cover any edge. *@
    @if ((_hovered ?? _focused) is { } interaction && interaction != Selected)
    {
        var p = Pixel(Board[interaction]);
        <g class="interaction-overlay" aria-hidden="true">
            <polygon class="selection-halo" points="@Points(p.X, p.Y)" />
            <polygon class="selection-outline" points="@Points(p.X, p.Y)" />
        </g>
    }
    @if (Selected is { } selected)
    {
        var p = Pixel(Board[selected]);
        <g class="selection-overlay" aria-hidden="true">
            <polygon class="selection-halo" points="@Points(p.X, p.Y)" />
            <polygon class="selection-outline" points="@Points(p.X, p.Y)" />
        </g>
    }
</svg>
</div>
<div class="board-legend"><span class="swatch forest">Forest</span><span class="swatch desert">Desert</span><span class="swatch water">Water</span><span class="swatch swamp">Swamp</span><span class="swatch mountain">Mountain</span><span>B = bear · C = cougar · ⬟ stone · ▲ shack</span></div>
@if (_showPieces)
{
    <div class="board-legend piece-legend"><span>■ cube / no · ● disc / yes</span>
        @foreach (var book in Markers.Select(m => m.Book).Distinct())
        { <span class="book-@ColorFor(book)"><span class="book-dot" aria-hidden="true"></span>@book · @ColorFor(book)</span> }
    </div>
}

@code {
    [Parameter, EditorRequired] public BoardState Board { get; set; } = default!;
    [Parameter] public Position? Selected { get; set; }
    [Parameter] public EventCallback<Position> SelectedChanged { get; set; }
    [Parameter] public IReadOnlyList<Marker> Markers { get; set; } = Array.Empty<Marker>();
    private bool _showPieces;
    private Position? _hovered, _focused;
    private const double Radius = 24;
    private string ColorFor(string book) => Catalog.Prototypes.Index<ClueBookPrototype>(book).Color;
    private (double X, double Y) Pixel(BoardSpace space) => HexCoordinates.ToPixel(space.Hex, Board.Definition.Orientation, Radius);
    private string ViewBox
    {
        get
        {
            var pixels = Board.Spaces.Select(Pixel).ToArray();
            return $"{F(pixels.Min(p => p.X) - 28)} {F(pixels.Min(p => p.Y) - 28)} {F(pixels.Max(p => p.X) - pixels.Min(p => p.X) + 56)} {F(pixels.Max(p => p.Y) - pixels.Min(p => p.Y) + 56)}";
        }
    }
    private string Points(double x, double y) => string.Join(" ", Enumerable.Range(0, 6).Select(i =>
    {
        var angle = (i * 60 + (Board.Definition.Orientation == Hex.Orientation.PointTop ? 30 : 0)) * System.Math.PI / 180;
        return $"{F(x + Radius * System.Math.Cos(angle))},{F(y + Radius * System.Math.Sin(angle))}";
    }));
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Label(BoardSpace s) => $"{s.Position}, {s.Terrain}" + (s.Animal == Animal.None ? "" : $", {s.Animal} territory") +
        (s.Structure is null ? "" : $", {s.Structure.Color} {s.Structure.Kind}");
    private Task Key(KeyboardEventArgs e, Position position) => e.Key is "Enter" or " " ? SelectedChanged.InvokeAsync(position) : Task.CompletedTask;
}
