@page "/opening"
@inject GameManager Game
@inject ContentCatalog Catalog
@inject BrowserSessionStore Storage
@inject NavigationManager Navigation
<PageTitle>Opening information · Cryptid Companion</PageTitle>
<p class="eyebrow">03 / FIRST SIGNS</p><h1>Mark what cannot be.</h1>
@if (!Game.HasSession)
{ <p>Choose your color before opening the other field journals.</p><a class="button" href="">Go to base camp</a> }
else if (Game.Phase != SessionPhase.Opening)
{ <p>Opening information is already recorded.</p><a class="button" href="game">Return to game</a> }
else
{
    <p class="lede">Place these cubes on your physical board. Each cube rules out a space for its clue-holder. Their clues stay sealed.</p>
    <div class="opening-grid">
        @foreach (var book in Game.Opponents)
        { <section class="panel"><p class="eyebrow player-@(Catalog.Prototypes.Index<ClueBookPrototype>(book).Color)">@book</p><h2>Two cubes</h2><div class="positions">@foreach (var marker in Game.Markers.Where(m => m.Book == book && m.Reason == "Opening")) { <span>■ @marker.Position</span> }</div></section> }
    </div>
    <section class="panel"><h2>Your opening cubes</h2><p>Your clue: <strong>@Game.HumanClueText</strong></p>
        <p>Place two of your own cubes on distinct spaces that fail your clue. Click a space or choose its coordinate, then confirm. Other players’ cubes may share that space.</p>
        <div class="control-row"><label for="opening-space">Your next cube</label><select id="opening-space" @bind="_selected">
            @foreach (var space in Game.Board!.Spaces) { <option value="@space.Position">@space.Position · @space.Terrain</option> }
        </select><button class="button" @onclick="Place" disabled="@(Game.PendingHumanCubes == 0)">Place my cube</button></div>
        <p role="status">@Game.PendingHumanCubes opening cubes remaining. @string.Join(", ", Game.Markers.Where(m => m.Book == Game.HumanBook).Select(m => m.Position))</p>
        @if (_error is not null) { <p role="alert" class="error">@_error</p> }
        <BoardView Markers="Game.Markers" Board="Game.Board!" Selected="SelectedPosition" SelectedChanged="Select" />
        <button class="button" @onclick="Continue" disabled="@(Game.PendingHumanCubes != 0)">All cubes placed — begin expedition →</button>
    </section>
}
@code {
    private string _selected = "A1";
    private string? _error;
    private Position SelectedPosition => Game.Board!.Spaces.First(s => s.Position.ToString() == _selected).Position;
    private void Select(Position position) => _selected = position.ToString();
    private async Task Place()
    {
        try { Game.PlaceHumanCube(SelectedPosition); await Storage.Save(); _error = null; }
        catch (Exception exception) { _error = exception.Message; }
    }
    private async Task Continue() { Game.StartPlay(); await Storage.Save(); Navigation.NavigateTo("game"); }
}
