@page "/choose"
@inject ContentCatalog Catalog
@inject CompanionState State
@inject GameManager Game
@inject BrowserSessionStore Storage
@inject NavigationManager Navigation
<PageTitle>Your color · Cryptid Companion</PageTitle>
<p class="eyebrow">02 / YOUR FIELD NOTES</p><h1>Choose your color.</h1>
@if (Game.HasSession)
{ <p>An expedition is already active. The card’s clues stay fixed until you end it.</p><a class="button" href="@(Game.Phase == SessionPhase.Opening ? "opening" : "game")">Resume expedition</a> }
else if (_setup is null)
{ <p>Choose a setup first.</p><a href="">Back to camp</a> }
else
{
    <section class="panel narrow"><p>The setup card assigns every clue. Choose which color you will play; your clue will be shown next, and the other books stay sealed.</p>
        <label for="book">Your color</label><select id="book" @bind="_book">
            @foreach (var book in _setup.Books) { <option value="@book.ID">@Catalog.Prototypes.Index(book).Color · @book.ID</option> }
        </select>
        <p class="field-note">Changing your color changes which clue you receive, not the card’s assignments.</p>
        <details><summary>Reproducible opening cubes</summary><label for="seed">Optional random seed</label><input id="seed" type="number" @bind="_seed" /><p class="field-note">The seed controls random cube placements. It never changes the card’s clues.</p></details>
        @if (_error is not null) { <p role="alert" class="error">@_error</p> }
        <button class="button full" @onclick="Begin">Take my assigned clue →</button>
    </section>
}
@code {
    private PlayerSetup? _setup;
    private string _book = "";
    private int? _seed;
    private string? _error;
    protected override void OnInitialized()
    {
        _setup = Catalog.Cards.FirstOrDefault(c => c.ID == State.DraftCard)?.Setups.FirstOrDefault(s => s.PlayerCount == State.DraftPlayers);
        if (_setup is not null) _book = _setup.Books[0].ID;
    }
    private async Task Begin()
    {
        try { Game.Begin(State.DraftCard, State.DraftPlayers, _book, _seed); await Storage.Save(); Navigation.NavigateTo("opening"); }
        catch (Exception exception) { _error = exception.Message; }
    }
}
